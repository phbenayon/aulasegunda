{
  "name": "lab-testes-jest",
  "version": "1.0.0",
  "scripts": {
    "test": "jest --verbose",
    "test:coverage": "jest --coverage",
    "test:report": "jest --reporters=default --reporters=jest-html-reporter"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-html-reporter": "^3.10.2"
  },
  "jest": {
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "Relatório de Teste de Software - ISO 29119",
          "outputPath": "./relatorio-testes.html",
          "includeFailureMsg": true
        }
      ]
    ]
  }
}
